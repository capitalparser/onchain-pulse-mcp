{
  "name": "onchain-pulse-mcp",
  "version": "0.0.1",
  "description": "Read-only MCP server exposing onchain market mood signals (CEX flow, on-chain wallets, derivatives, ETF/RWA macro, Korea premium) for AI agents and humans.",
  "license": "MIT",
  "author": "Kim Kyung-jun <iwbasm92@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "onchain-pulse-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "config",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "dashboard": "tsx src/index.ts dashboard",
    "console-gateway": "tsx src/index.ts console-gateway",
    "compass-backtest": "tsx src/index.ts compass-backtest",
    "intelligence-collect": "tsx src/index.ts intelligence-collect",
    "telegram-alert": "tsx src/index.ts telegram-alert",
    "telegram-daemon": "tsx src/index.ts telegram-daemon",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live:eth-value": "RUN_LIVE_ETH_VALUE=1 vitest run tests/live/eth_value_capture.live.test.ts",
    "test:live:eth-rpc": "RUN_LIVE_ETH_RPC=1 vitest run tests/live/eth_fee_cross_check.live.test.ts",
    "test:live:eth-collateral": "RUN_LIVE_ETH_COLLATERAL=1 vitest run tests/live/eth_collateral_demand.live.test.ts",
    "test:live:spark-collateral": "RUN_LIVE_SPARK_COLLATERAL=1 vitest run tests/live/spark_eth_collateral_capacity.live.test.ts",
    "test:live:lido-backing": "RUN_LIVE_LIDO_BACKING=1 vitest run tests/live/lido_pooled_eth_backing.live.test.ts",
    "test:live:sky-eth-custody": "RUN_LIVE_SKY_ETH_CUSTODY=1 vitest run tests/live/sky_eth_collateral_custody.live.test.ts",
    "test:live:eigenlayer-restaking": "RUN_LIVE_EIGENLAYER_ETH_RESTAKING=1 vitest run tests/live/eigenlayer_eth_restaking_exposure.live.test.ts",
    "test:live:eigenlayer-lst-quotes": "RUN_LIVE_EIGENLAYER_LST_ETH_QUOTES=1 vitest run tests/live/eigenlayer_lst_eth_quotes.live.test.ts",
    "test:live:eth-beacon": "RUN_LIVE_ETH_BEACON=1 vitest run tests/live/eth_consensus_rewards_cross_check.live.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "onchain",
    "crypto",
    "rwa",
    "market-pulse",
    "trading",
    "ai-agent",
    "byok"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capitalparser/onchain-pulse-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/capitalparser/onchain-pulse-mcp/issues"
  },
  "homepage": "https://github.com/capitalparser/onchain-pulse-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "cheerio": "^1.0.0",
    "lru-cache": "^11.0.2",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
